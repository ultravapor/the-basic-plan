---
// 광고 랜딩 전용 측정. BaseLayout의 head 슬롯에 넣어 /diagnosis/에서만 출력된다.
// - Vercel Analytics는 BaseLayout에 이미 있으므로 다시 설치하지 않는다.
// - Meta Pixel: PUBLIC_META_PIXEL_ID가 있을 때만 출력. PageView는 여기서 정확히 1회.
//   (사이트에 페이지 전환 라우터가 없어 방문 1회 = 페이지 로드 1회 → 중복 PageView가 생기지 않는다)
// - 이벤트 전송은 tracking.ts의 track() 한 곳에서 Meta·Vercel로 나눠 보낸다.
import { LANDING } from './config';

const { metaPixelId } = LANDING;
---

{metaPixelId && (
  <script is:inline define:vars={{ metaPixelId }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', metaPixelId);
    window.fbq('track', 'PageView');
  </script>
)}

<script>
  import { track } from './tracking';

  track('page_view');

  // CTA 클릭: 위임 방식이라 CTA가 몇 개든, 나중에 교체돼도 data-lp-cta만 있으면 잡힌다.
  // 폼은 새 탭으로 열리므로 이 페이지가 살아 있는 동안 이벤트 전송이 끝난다.
  document.addEventListener('click', (e) => {
    const el = (e.target as Element | null)?.closest?.('[data-lp-cta]');
    if (el) track('cta_click', { cta_location: el.getAttribute('data-lp-cta') ?? '' });
  });
</script>
