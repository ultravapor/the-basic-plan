    border-radius:999px; padding:8px 16px; font-weight:600; font-size:.95rem; }
  .funnel-arrow { color:var(--accent); font-weight:700; }
  .flow-notes { margin:0 0 6px; padding-left:18px; color:var(--muted); max-width:660px; }
  .flow-notes li { margin:6px 0; }

  .check-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .check-card { border:1px solid var(--border); border-radius:var(--radius); padding:20px 22px; background:var(--surface); }
  .check-head { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
  .check-n { display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px;
    border-radius:50%; background:var(--accent); color:var(--accent-ink); font-weight:700; font-size:.85rem; flex:none; }
  .check-head h3 { margin:0; font-size:1.1rem; }
  .check-lead { color:var(--muted); margin:0 0 10px; font-size:.95rem; }
  .check-card ul { margin:0; padding-left:18px; }
  .check-card li { margin:4px 0; }
  .check-tail { color:var(--muted); font-size:.88rem; margin:12px 0 0; padding-top:10px; border-top:1px solid var(--border); }

  .report-card { border:1px solid var(--border); border-left:3px solid var(--accent);
    border-radius:12px; overflow:hidden; }
  .report-row { display:grid; grid-template-columns:200px 1fr; gap:16px; padding:13px 18px; }
  .report-row + .report-row { border-top:1px solid var(--border); }
  .report-row .rk { font-weight:600; color:var(--accent); font-size:.9rem; }
  .report-row .rv { font-size:.95rem; }

  .fit-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .fit-col { border:1px solid var(--border); border-radius:var(--radius); padding:20px 22px; background:var(--surface); }
  .fit-col h3 { margin:0 0 12px; font-size:1.05rem; }
  .fit-col ul { margin:0; padding-left:18px; }
  .fit-col li { margin:7px 0; }
  .fit-col.yes { border-top:3px solid var(--accent); }
  .fit-col.no { border-top:3px solid var(--border); }
  .fit-col.no li { color:var(--muted); }

  .promise-list { max-width:660px; margin:14px 0 6px; padding-left:0; list-style:none; }
  .promise-list li { position:relative; padding:8px 0 8px 26px; border-bottom:1px solid var(--border); }
  .promise-list li::before { content:"✓"; position:absolute; left:2px; color:var(--accent); font-weight:700; }

  .bottleneck-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:6px 0 16px; }
  .bn { display:flex; flex-direction:column; gap:3px; background:var(--surface); border:1px solid var(--border);
    border-radius:12px; padding:12px 14px; }
  .bn-stage { font-weight:700; color:var(--accent); font-size:.9rem; }
  .bn-b { color:var(--muted); font-size:.85rem; line-height:1.45; }

  .report-badge { display:inline-block; margin:14px 14px 0; padding:3px 10px; border-radius:999px;
    background:var(--surface); border:1px solid var(--border); color:var(--muted); font-size:.72rem; font-weight:600; }

  .conclusion-list { max-width:660px; margin:14px 0 0; padding-left:0; list-style:none;
    display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .conclusion-list li { position:relative; padding:10px 12px 10px 30px; background:var(--surface);
    border:1px solid var(--border); border-radius:10px; font-size:.92rem; }
  .conclusion-list li::before { content:"—"; position:absolute; left:12px; color:var(--accent); font-weight:700; }

  @media (max-width:640px) {
    .bottleneck-grid { grid-template-columns:1fr; }
    .conclusion-list { grid-template-columns:1fr; }
  }

  @media (max-width:640px) {
    .check-grid, .fit-grid { grid-template-columns:1fr; }
    .report-row { grid-template-columns:1fr; gap:4px; }
