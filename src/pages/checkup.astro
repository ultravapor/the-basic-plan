---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const url = new URL('/checkup/', Astro.site).href;
const orgId = new URL('/#org', Astro.site).href;
const contactHref = SITE.naverFormUrl || '/#contact';

const funnel = ['발견', '관심', '비교', '문의', '응대', '예약'];

const bottlenecks = [
  { stage: '발견', b: '검색·플레이스에 아예 뜨지 않음 (색인·키워드 문제)' },
  { stage: '관심', b: '떠도 차별점이 전달되지 않아 그냥 나감' },
  { stage: '비교', b: '다른 병원과 비교할 선택 기준이 없음' },
  { stage: '문의', b: '연락 경로·CTA가 불명확해 행동으로 안 이어짐' },
  { stage: '응대', b: '전화는 오는데 예약 제안이 약함' },
  { stage: '예약', b: '예약 직전 불안·번거로움으로 이탈' },
];

// D. 하지 않는 것 공개 — 진단 결과에 따라 나올 수 있는 결론들
const conclusions = [
  '현재 대행사를 유지하세요.',
  '블로그 발행량을 늘릴 필요가 없습니다.',
  '지금은 광고보다 내부 응대 개선이 먼저입니다.',
  'AEO·GEO는 아직 우선순위가 아닙니다.',
  '현재는 추가 마케팅이 필요하지 않습니다.',
];

const areas = [
  {
    n: '1', title: '발견',
    lead: '환자가 실제로 우리 병원을 발견할 수 있는 상태인지 확인합니다.',
    items: ['네이버 검색', '플레이스', '구글 검색', '홈페이지', '주요 콘텐츠', '필요한 경우 AI 검색 노출 가능성'],
    tail: '검색 결과에서 병원이 어떤 모습으로 보이는지도 함께 봅니다.',
  },
  {
    n: '2', title: '관심과 비교',
    lead: '발견된 뒤 환자가 계속 읽을 이유가 있는지 확인합니다.',
    items: ['환자가 궁금해하는 질문에 답하고 있는지', '진료의 특징이 구체적으로 설명되는지', '다른 병원과 비교할 판단 기준이 제공되는지', '광고 문구만 반복하고 있지는 않은지', '콘텐츠와 실제 진료 방향이 연결되는지'],
    tail: '글이 많은지가 아니라, 환자의 판단을 돕는 정보가 있는지를 봅니다.',
  },
  {
    n: '3', title: '문의',
    lead: '관심을 가진 환자가 실제 행동으로 이어질 수 있는지 봅니다.',
    items: ['전화·예약·상담 경로가 명확한지', '필요한 정보를 쉽게 찾을 수 있는지', '문의 직전 생기는 불안이나 의문이 남아 있지는 않은지', '홈페이지와 콘텐츠의 안내가 자연스러운지'],
    tail: '',
  },
  {
    n: '4', title: '응대 (필요한 경우)',
    lead: '문의는 오는데 예약이 안 된다면, 유입을 늘리는 것만으로는 해결되지 않습니다. 미스터리콜 등으로 확인합니다.',
    items: ['전화 연결 과정', '환자의 질문을 파악하는 방식', '설명 방식', '가격 문의 대응', '예약 제안', '통화 마무리'],
    tail: '직원을 평가하거나 점수를 매기는 것이 아니라, 환자가 문의 후 어디에서 멈추는지를 확인하는 것이 목적입니다.',
  },
];

const fitYes = [
  '마케팅 비용은 계속 나가는데 무엇이 잘되고 있는지 모르겠다',
  '블로그나 광고는 하고 있지만 신규환자 변화가 체감되지 않는다',
  '검색 순위는 괜찮은데 문의가 적다',
  '문의는 들어오는데 예약으로 잘 이어지지 않는다',
  '현재 대행사를 계속 이용해야 할지 판단하기 어렵다',
  'AEO·GEO 등 새 채널이 신경 쓰이지만 지금 필요한 투자인지 모르겠다',
  '무언가를 더 시작하기 전에 현재 상태부터 정리하고 싶다',
];
const fitNo = [
  '이미 유입경로와 전환 데이터를 계속 확인하고 있고, 무엇을 개선할지도 명확한 경우',
  '단기간에 광고 집행량을 빠르게 늘리는 것이 명확한 목표인 경우 (광고 실행사가 더 적절)',
  '특정 검색 순위나 신규환자 수를 보장받고 싶은 경우 (저희 방식과 맞지 않음)',
];

const promise = [
  '현재 환자 유입 과정에서 무엇이 관찰되는지',
  '어떤 문제가 가장 우선순위가 높은지',
  '왜 그렇게 판단했는지',
  '지금 해야 할 것과 하지 않아도 될 것을 어떻게 구분했는지',
  '개선 후 무엇을 확인해야 하는지',
];

const faq = [
  { q: '점검을 받으면 반드시 대행 계약을 해야 하나요?', a: '아니요. 점검 결과만 가지고 병원 내부에서 직접 개선하셔도 되고, 현재 대행사에 전달해 수정하셔도 됩니다. 필요한 영역이 저희가 직접 도울 수 있는 부분일 때만 별도로 제안드립니다. 진행 여부는 내용을 확인하신 뒤 결정하시면 됩니다.' },
  { q: '순위나 신규환자 수를 보장하나요?', a: '보장하지 않습니다. 마케팅 결과에는 진료과·지역 경쟁·병원 평판·가격·실제 진료 경험 등 저희가 통제할 수 없는 요소도 영향을 줍니다. 대신 무엇이 관찰되는지, 어떤 문제가 우선인지, 왜 그렇게 판단했는지 근거를 남깁니다.' },
  { q: '무엇을 점검하나요?', a: '발견 → 관심·비교 → 문의 → 응대로 이어지는 흐름에서 환자가 어디서 이탈하는지를 확인합니다. 처음부터 해결책을 정하지 않고, 어디가 병목인지부터 찾습니다.' },
  { q: '전화 응대(미스터리콜)도 보나요?', a: '필요한 경우에만 봅니다. 문의는 오는데 예약이 안 되는 병원은 유입을 늘려도 해결되지 않기 때문입니다. 직원 평가가 목적이 아니라, 환자가 문의 후 어디서 멈추는지 확인하는 것이 목적입니다.' },
  { q: '점검 결과 지금 아무것도 안 해도 된다고 나올 수도 있나요?', a: '있습니다. 현재 대행사가 충분히 잘하고 있다면 굳이 바꿀 이유가 없다고 말씀드릴 수도 있습니다. 저희 서비스를 파는 것보다, 지금 병원에 가장 먼저 필요한 일이 무엇인지 구분하는 것을 우선합니다.' },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: '병원 유입·전환 점검',
  serviceType: '병원 마케팅 진단',
  provider: { '@id': orgId },
  areaServed: 'KR',
  url,
  description: '마케팅을 더 늘리기 전에, 환자가 발견→관심→비교→문의→응대→예약의 어느 단계에서 이탈하는지부터 확인하는 병원 마케팅 진단 서비스. 결과에 따라 무엇을 해야 하고 무엇을 하지 않아도 되는지 우선순위로 정리하며, 순위·신규환자 수를 보장하지 않는다.',
  audience: { '@type': 'Audience', audienceType: '병·의원·동물병원 원장' },
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="우리 병원 유입·전환 점검"
  description="마케팅을 더 하기 전에, 환자가 발견부터 예약까지 어디에서 멈추는지부터 확인하는 병원 유입·전환 점검입니다. 무엇을 하고 무엇을 하지 않아도 될지 우선순위로 정리해드립니다. 순위·신환 수는 보장하지 않습니다."
  path="/checkup/"
  jsonLd={[serviceJsonLd, faqJsonLd]}
>
  <!-- 히어로 -->
  <section class="hero">
    <span class="eyebrow">병원 유입·전환 점검</span>
    <h1 class="hook">마케팅을 더 하기 전에,<br />어디서 환자를 놓치고 있는지부터 확인합니다</h1>
    <p class="lead">
      블로그를 늘려야 할지, 광고를 더 해야 할지, 홈페이지를 고쳐야 할지 고민하고 계신가요?
      문제는 마케팅을 하고 있지 않아서가 아닐 수 있습니다. 이미 검색되고 문의도 들어오지만,
      환자가 병원을 발견한 뒤 예약하기까지의 과정 어딘가에서 계속 이탈하고 있을 수 있습니다.
    </p>
    <p class="lead" style="margin-top:12px">
      이 상태에서 콘텐츠나 광고를 더 얹으면 비용만 늘고 문제는 그대로 남습니다. 점검은 무엇을
      더 하라고 제안하기 전에, 지금 어디에서 환자를 놓치고 있는지부터 확인하는 서비스입니다.
    </p>
    <div class="cta-row">
      <a class="btn primary" href={contactHref} data-ev="diagnostic_cta_click" data-ev-loc="hero" target={SITE.naverFormUrl ? '_blank' : undefined} rel={SITE.naverFormUrl ? 'noopener noreferrer' : undefined}>우리 병원 점검 신청하기</a>
      <a class="btn ghost" href="/posts/">인사이트 먼저 보기</a>
    </div>
  </section>

  <!-- 흐름 -->
  <section aria-labelledby="flow">
    <h2 id="flow" class="section-title">먼저 이런 흐름으로 봅니다</h2>
    <p style="color:var(--muted);max-width:640px">
      환자가 병원을 선택하는 과정은 한 번에 이루어지지 않습니다. 각 단계가 다음으로 자연스럽게
      이어져야 실제 신환으로 연결됩니다.
    </p>
    <div class="funnel" role="list">
      {funnel.map((f, i) => (
        <>
          <span class="funnel-step" role="listitem">{f}</span>
          {i < funnel.length - 1 && <span class="funnel-arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
    <div class="bottleneck-grid">
      {bottlenecks.map((x) => (
        <div class="bn"><span class="bn-stage">{x.stage}</span><span class="bn-b">{x.b}</span></div>
      ))}
    </div>
    <ul class="flow-notes">
      <li>검색 노출은 충분한데 문의가 적다면, 콘텐츠나 홈페이지의 문제일 수 있습니다.</li>
      <li>문의는 많은데 예약이 적다면, 마케팅보다 전화 응대 과정의 문제일 수 있습니다.</li>
      <li>검색 자체가 거의 안 된다면, 그때는 콘텐츠·검색 노출을 먼저 개선해야 합니다.</li>
    </ul>
    <p class="verdict-line">중요한 것은 처음부터 해결책을 정하지 않는 것입니다.</p>
  </section>

  <!-- 무엇을 점검하나 -->
  <section aria-labelledby="what">
    <h2 id="what" class="section-title">무엇을 점검하나요</h2>
    <div class="check-grid">
      {areas.map((a) => (
        <div class="check-card">
          <div class="check-head"><span class="check-n">{a.n}</span><h3>{a.title}</h3></div>
          <p class="check-lead">{a.lead}</p>
          <ul>{a.items.map((it) => <li>{it}</li>)}</ul>
          {a.tail && <p class="check-tail">{a.tail}</p>}
        </div>
      ))}
    </div>
  </section>

  <!-- 정리 방식 -->
  <section aria-labelledby="report">
    <h2 id="report" class="section-title">점검 후에는 이렇게 정리합니다</h2>
    <p style="color:var(--muted);max-width:640px">
      문제를 나열하기보다 우선순위를 정합니다. 아래는 실제 고객 사례가 아니라, 결과가 어떤
      형태로 정리되는지 보여주는 예시입니다.
    </p>
    <div class="report-card">
      <div class="report-badge">예시 — 실제 고객 사례 아님</div>
      <div class="report-row"><span class="rk">현재 가장 큰 병목</span><span class="rv">비교 → 문의 단계</span></div>
      <div class="report-row"><span class="rk">그렇게 판단한 이유</span><span class="rv">검색 노출과 콘텐츠 유입은 유지되지만, 홈페이지에서 주요 진료의 선택 기준과 다음 행동이 명확하지 않음</span></div>
      <div class="report-row"><span class="rk">가장 먼저 할 일</span><span class="rv">1. 주요 진료 페이지 메시지 재구성 · 2. 문의 동선 단순화 · 3. 기존 콘텐츠와 진료 페이지 연결</span></div>
      <div class="report-row"><span class="rk">지금 하지 않아도 되는 것</span><span class="rv">블로그 발행량 증가</span></div>
      <div class="report-row"><span class="rk">병원 내부에서 확인할 것</span><span class="rv">문의 전화 중 실제 예약으로 이어지는 비율</span></div>
      <div class="report-row"><span class="rk">더베이직플랜이 도울 부분</span><span class="rv">진료 페이지 재구성 및 콘텐츠 연결</span></div>
    </div>
    <p style="color:var(--muted);max-width:660px;margin-top:14px">
      모든 문제를 저희 서비스로 해결하려고 하지 않습니다. 검색 노출이 부족하면 콘텐츠가,
      홈페이지에서 이탈하면 페이지 구조가, 문의까지는 충분하면 전화 응대가 먼저일 수 있습니다.
      현재 대행사가 충분히 잘하고 있다면 굳이 바꿀 이유가 없다고 말씀드릴 수도 있습니다.
    </p>
  </section>

  <!-- 하지 않는 것 공개 (가능한 결론) -->
  <section aria-labelledby="conclusions">
    <h2 id="conclusions" class="section-title">진단 결과, 이런 결론도 가능합니다</h2>
    <p style="color:var(--muted);max-width:640px">
      점검이 항상 "이걸 더 하세요"로 끝나지 않습니다. 실제로 다음과 같은 결론이 나올 수 있고,
      그렇게 말씀드립니다.
    </p>
    <ul class="conclusion-list">
      {conclusions.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <!-- 적합/비적합 -->
  <section aria-labelledby="fit">
    <h2 id="fit" class="section-title">이런 병원이라면 도움이 됩니다</h2>
    <div class="fit-grid">
      <div class="fit-col yes">
        <h3>점검이 도움이 될 수 있는 경우</h3>
        <ul>{fitYes.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="fit-col no">
        <h3>굳이 필요하지 않을 수 있는 경우</h3>
        <ul>{fitNo.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 약속 -->
  <section aria-labelledby="promise">
    <h2 id="promise" class="section-title">약속할 수 있는 것과 없는 것</h2>
    <p style="color:var(--muted);max-width:660px">
      마케팅 결과에는 저희가 통제할 수 없는 요소도 영향을 줍니다. 그래서 특정 순위·문의 수·신규환자
      수를 보장하지 않습니다. 대신 다음은 분명하게 확인해 드립니다.
    </p>
    <ul class="promise-list">
      {promise.map((p) => <li>{p}</li>)}
    </ul>
    <p class="verdict-line">결과를 장담하는 대신, 판단 근거가 남도록 하겠습니다.</p>
  </section>

  <!-- 계약 의무 없음 -->
  <section aria-labelledby="nocontract">
    <h2 id="nocontract" class="section-title">점검 이후 반드시 계약할 필요는 없습니다</h2>
    <div class="answer">
      <span class="k">진행은 원장님이 결정</span>
      점검 결과만 가지고 병원 내부에서 직접 개선하셔도 되고, 현재 대행사에 전달해 수정하셔도
      됩니다. 필요한 영역이 저희가 직접 도울 수 있는 부분이라면 그때 별도로 제안드립니다.
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="section-title">자주 묻는 질문</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <!-- 최종 CTA -->
  <section>
    <div class="cta-band">
      <div>
        <strong>지금 필요한 것이 ‘마케팅 추가’인지부터 확인해보세요.</strong>
        <span>현재 진행 중인 마케팅과 가장 답답한 부분을 알려주시면 먼저 살펴보겠습니다. 상담 전화로 영업하지 않습니다.</span>
      </div>
      <a class="btn primary" href={contactHref} data-ev="diagnostic_cta_click" data-ev-loc="cta-band" target={SITE.naverFormUrl ? '_blank' : undefined} rel={SITE.naverFormUrl ? 'noopener noreferrer' : undefined}>유입·전환 점검 신청하기</a>
    </div>
  </section>

  <script is:inline>
    // 진단 퍼널 이벤트 (Vercel Analytics 커스텀 이벤트). window.va 없으면 조용히 무시.
    (function () {
      function track(name, data) { try { window.va && window.va('event', { name: name, data: data }); } catch (e) {} }
      track('diagnostic_page_view');
      document.querySelectorAll('[data-ev]').forEach(function (el) {
        el.addEventListener('click', function () {
          track(el.getAttribute('data-ev'), { loc: el.getAttribute('data-ev-loc') || '' });
        });
      });
    })();
  </script>
</BaseLayout>

<style>
