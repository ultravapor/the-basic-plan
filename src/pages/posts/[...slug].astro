---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, isPublished } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (date: Date) => date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const url = new URL(`/posts/${post.id}/`, Astro.site).href;
const orgId = new URL('/#org', Astro.site).href;
const founderId = new URL('/about/#founder', Astro.site).href;

// Article: 가시 텍스트 기반, 저자 = 창업자 Person(E-E-A-T), 발행자 = Organization
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${url}#article`,
  url,
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  inLanguage: 'ko',
  keywords: d.keywords.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@id': founderId, '@type': 'Person', name: SITE.founder },
  publisher: { '@id': orgId },
};

// FAQPage: frontmatter faq 가 있을 때만. 가시 텍스트(아래 렌더)와 100% 동일.
const faqJsonLd =
  d.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: '인사이트', item: new URL('/posts/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};

const jsonLd = [articleJsonLd, breadcrumb, ...(faqJsonLd ? [faqJsonLd] : [])];

// 관련 글 자동 연결 (사고의 순서): 지정된 이전/다음 글 → 같은 카테고리 → 키워드 겹침 순.
const all = await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate));
const bySlug = (s?: string) => (s ? all.find((p) => p.id === s) : undefined);
const related: typeof all = [];
const push = (p?: (typeof all)[number]) => {
  if (p && p.id !== post.id && !related.some((r) => r.id === p.id)) related.push(p);
};
push(bySlug(d.nextArticle));
push(bySlug(d.prevArticle));
if (related.length < 3 && d.category) {
  for (const p of all) { if (p.data.category === d.category) push(p); if (related.length >= 3) break; }
}
if (related.length < 3) {
  const kw = new Set(d.keywords.filter((k) => k !== '병원 마케팅')); // 너무 흔한 키워드 제외
  const scored = all
    .filter((p) => p.id !== post.id && !related.some((r) => r.id === p.id))
    .map((p) => ({ p, s: p.data.keywords.filter((k) => kw.has(k)).length }))
    .filter((x) => x.s > 0)
    .sort((a, b) => b.s - a.s);
  for (const { p } of scored) { push(p); if (related.length >= 3) break; }
}
const relatedTop = related.slice(0, 3);
---

<BaseLayout title={d.title} description={d.description} path={`/posts/${post.id}/`} ogType="article" jsonLd={jsonLd}>
  <article class="prose" style="padding-top:40px">
    <nav aria-label="위치" style="font-size:.85rem;color:var(--muted);margin-bottom:14px">
      <a href="/">홈</a> › <a href="/posts/">인사이트</a>
    </nav>

    <h1>{d.title}</h1>
    <div class="meta" style="color:var(--muted);font-size:.9rem;margin-bottom:24px">
      {fmt(d.pubDate)}
      {d.updatedDate && <> · 갱신 {fmt(d.updatedDate)}</>}
      · 작성: <a href="/about/">{SITE.nameKo}</a>
    </div>

    <!-- 첫 화면 직답 (AEO: 40자 내외 결론 먼저) -->
    <div class="answer">
      <span class="k">한 줄 결론</span>
      {d.answer}
    </div>

    <Content />

    {d.faq.length > 0 && (
      <section class="faq" style="margin-top:40px">
        <h2>자주 묻는 질문</h2>
        {d.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    {relatedTop.length > 0 && (
      <section class="related" aria-labelledby="related-h" style="margin-top:44px">
        <h2 id="related-h" style="font-size:1.05rem">이어서 읽으면 좋은 글</h2>
        <ul class="related-list">
          {relatedTop.map((p) => (
            <li>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <span>{p.data.answer}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr style="border:none;border-top:1px solid var(--border);margin:36px 0 22px" />
    <div class="post-funnel">
      <p>
        환자가 병원을 발견해 예약하기까지의 전체 그림은
        <a href="/guide/">병원 신규환자 검색경로 메모(웹·PDF)</a>에 정리해 두었습니다.
      </p>
      <p>
        우리 병원은 지금 어디에서 멈추고 있을까요. 질문 5개에 답하면
        <a href="/checkup/">무료 진단 리포트</a>를 이메일로 보내드립니다. 보장이 아니라 진단입니다.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .related-list { list-style:none; margin:14px 0 0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .related-list li { border:1px solid var(--border); border-radius:12px; padding:14px 16px; background:var(--surface); }
  .related-list a { font-weight:600; text-decoration:none; }
  .related-list a:hover { text-decoration:underline; }
  .related-list span { display:block; margin-top:4px; color:var(--muted); font-size:.9rem; line-height:1.5; }
  .post-funnel { background:var(--surface); border:1px solid var(--border); border-left:3px solid var(--accent);
    border-radius:12px; padding:16px 18px; }
  .post-funnel p { margin:0 0 8px; color:var(--muted); }
  .post-funnel p:last-child { margin-bottom:0; }
</style>
