---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, isPublished } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const faq = [
  {
    q: '이전 대행사도 다 "잘한다"고 했는데, 여긴 뭐가 다른가요?',
    a: '더베이직플랜은 수의사·동물병원 원장 출신 대표가 직접 총괄하고, 대행 전 원장님과 1시간 인터뷰로 진료 철학부터 듣습니다. 병원명을 지우면 어디에도 붙는 복붙 글이 아니라, 그 병원만의 강점을 설득하는 콘텐츠를 만드는 것이 차이입니다.',
  },
  {
    q: '상위노출이나 신환 수를 "보장"해 주나요?',
    a: '보장하지 않습니다. "즉시 효과·상위노출 보장"은 저희가 가장 먼저 피하라고 말하는 위험 신호입니다. 병원 마케팅은 신뢰를 쌓는 브랜딩이라 시간이 필요합니다. 저희는 보장 대신 과정과 측정(노출·클릭·문의)을 약속합니다.',
  },
  {
    q: '원장이 바빠서 신경 못 쓰는데, 다 알아서 해주시나요?',
    a: '"다 알아서 하겠다"는 저희가 경계하는 첫 번째 신호입니다. 대신 처음 1시간 인터뷰로 방향만 함께 잡고, 이후 실행은 저희가 맡습니다. 소통은 최소한으로, 부담은 적게 — 그래도 원장님의 철학이 콘텐츠에 담기게 합니다.',
  },
  {
    q: '성과가 있는지 어떻게 확인하나요?',
    a: '"조회수 XXX회" 자랑이 아니라, 노출·클릭·문의(전환)를 기준선부터 추적해 보고합니다. "조회수는 많은데 왜 예약 전화가 안 오나"에 답할 수 있어야 진짜 마케팅입니다.',
  },
  {
    q: '월 비용은 얼마인가요? 최저가 대행사와 뭐가 다른가요?',
    a: '"업계 최저가"만 앞세우는 곳은 저희도 경계합니다. 품질 낮은 콘텐츠는 병원 이미지를 오히려 깎아먹기 때문입니다. 비용은 병원 상황을 진단한 뒤 안내드리며, 무료 진단부터 부담 없이 시작하실 수 있습니다.',
  },
  {
    q: '담당자가 자주 바뀌지 않나요?',
    a: '수의사·동물병원 원장 출신 대표가 직접 총괄합니다. 좋은 대행사는 원장님을 "고객"이 아니라 "파트너"로 봅니다 — 원장님의 성공이 곧 저희의 성공이라 생각합니다.',
  },
  {
    q: '아직 확신이 안 서는데, 바로 계약해야 하나요?',
    a: '아니요. 저희 인사이트 칼럼을 몇 개 먼저 읽어보시고, 방향이 맞는다 싶을 때 무료 진단을 신청하셔도 됩니다. 핏이 맞는 파트너를 찾는 것이 서로에게 좋습니다.',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={SITE.nameKo} jsonLd={[faqJsonLd]}>
  <!-- ① 주인공 + 후킹 : 손님(원장)의 아픔에서 시작 -->
  <section class="hero">
    <span class="eyebrow">뭘 더 팔기 전에, 뭐가 새는지 먼저 찾습니다 · 진단 → 우선순위 → 실행 → 측정</span>
    <p class="hook">블로그도 하고 플레이스도 관리하는데,<br />신규 문의만 왜 줄어들까요?</p>
    <h1>병원 마케팅, 더 하기 전에<br />어디서 새는지부터 봅니다</h1>
    <p class="lead">
      더베이직플랜은 병·의원과 동물병원의 검색 유입을 <strong>먼저 진단합니다</strong>.<br />
      무엇을 더 하고 무엇을 멈춰도 되는지 우선순위를 잡아드리고,<br />
      블로그·플레이스·홈페이지·AEO/GEO는 그다음 필요한 만큼 붙이는 실행 수단입니다.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/checkup/">우리 병원, 어디서 막히는지 점검</a>
      <a class="btn ghost" href="/posts/">인사이트 먼저 보기</a>
    </div>
  </section>

  <!-- ② 문제 : 외적 + 내적(속마음) -->
  <section aria-labelledby="problem">
    <h2 id="problem" class="section-title">이런 상황, 낯익지 않으신가요?</h2>
    <div class="problem">
      <ul>
        <li>블로그 포스팅을 꾸준히 올려도 예약 전화가 드물다</li>
        <li>광고비는 늘어나는데 신환 문의는 기대에 못 미친다</li>
        <li>대행사는 잘한다는데, 우리 병원 매출은 그대로</li>
        <li>조회수는 자랑하는데 “왜 예약이 안 오냐”엔 답을 못 함</li>
      </ul>
    </div>
    <div class="voices">
      <p>“이번 대행사는 다를 거야… 했는데 또 실망”</p>
      <p>“월 비용만 나가고 변한 건 없네”</p>
      <p>“담당자가 또 바뀌었다고?”</p>
    </div>
    <p class="verdict-line">
      가장 아픈 건 돈이 아닙니다. <strong>기대했다가 또 실망하는, 그 마음의 상처</strong>입니다.
    </p>
  </section>

  <!-- ③ 점검자 포지션 : 왜 우리인가가 아니라, 나는 이렇게 본다 -->
  <section aria-labelledby="guide">
    <h2 id="guide" class="section-title">저는 팔기 전에, 먼저 봅니다</h2>
    <div class="founder" style="margin-bottom:18px">
      <div class="avatar" aria-hidden="true">강</div>
      <div>
        <p style="margin:0"><strong>{SITE.founder}</strong> · {SITE.nameKo} 대표 · {SITE.founderBackground}</p>
        <p class="who">병원 안에서 운영해 본 사람으로서, 검색으로 발견된 이후 문의·응대·예약까지 어디서 멈추는지를 봅니다.</p>
      </div>
    </div>
    <p style="color:var(--muted);max-width:640px">
      저는 무엇을 더 하라고 권하기 전에, 지금 무엇이 되고 있고 무엇이 새고 있는지부터 봅니다.
      그래서 때로는 “지금은 더 안 쓰셔도 됩니다”라고 말합니다. 성과를 장담하는 대신, 무엇이
      관찰되고 무엇이 아직 불확실한지 판단 근거를 남기는 것 — 그게 제가 일하는 방식입니다.
    </p>
    <p style="color:var(--muted);max-width:640px;margin-top:10px">
      제가 믿고 맡길 만한 사람인지 검증할 자료는 <a href="/about/">소개</a>에 정리해 뒀습니다.
      경력 자랑이 아니라, 무엇을 하고 무엇을 하지 않는지 확인하실 수 있게요.
    </p>
  </section>

  <!-- ④ 계획 : 위험을 없애는 명확한 여정 -->
  <section aria-labelledby="how">
    <h2 id="how" class="section-title">그래서, 이렇게 진행됩니다</h2>
    <div class="steps">
      <div class="step"><div>
        <h3>대행 전, 원장님과 1시간 인터뷰</h3>
        <p>병원 철학·환자층·운영 방식까지. 모든 전략은 원장님의 ‘진료 철학’을 듣는 데서 시작합니다.</p>
      </div></div>
      <div class="step"><div>
        <h3>원장님 관점의 키워드 분석</h3>
        <p>단순 검색량이 아니라 “우리 병원에 맞는 환자가 찾는 키워드”. 검색량 높은 키워드가 때론 독이 됩니다.</p>
      </div></div>
      <div class="step"><div>
        <h3>마케팅 누수 지점 진단</h3>
        <p>블로그·플레이스·유튜브 중 어디서 전환이 새는지 정확히 짚습니다. “아, 여기서 새고 있었구나!”</p>
      </div></div>
      <div class="step"><div>
        <h3>향후 3개월 맞춤 전략</h3>
        <p>병원에 맞는 우선순위를 정하고, 무엇을 먼저 하고 무엇을 지금 하지 않아도 되는지 근거와 함께 정리해 드립니다.</p>
      </div></div>
    </div>
  </section>

  <!-- 판단 기준 : 우리 자랑이 아니라, 원장님이 대행사를 판단하는 법 -->
  <section aria-labelledby="diff">
    <h2 id="diff" class="section-title">대행사를 판단하는 3가지 기준</h2>
    <p style="color:var(--muted);max-width:640px;margin-top:-4px">
      저희를 고르라는 표가 아닙니다. 어느 대행사를 보든 이 신호로 판단해 보세요.
    </p>
    <table class="compare">
      <thead><tr><th>이런 말이 나오면 (위험 신호)</th><th>이렇게 판단하세요</th></tr></thead>
      <tbody>
        <tr><td>“원장님은 진료만 하세요, 다 알아서 할게요”</td><td>진료 철학을 묻지 않는 곳은 어디에도 붙는 복붙 콘텐츠일 확률이 높습니다. 우리 병원을 이해하려 하는지 보세요.</td></tr>
        <tr><td>“즉시 효과·상위노출 보장합니다”</td><td>보장은 통제할 수 없는 것을 약속하는 신호입니다. 결과 대신 과정과 측정을 말하는지 보세요.</td></tr>
        <tr><td>“업계 최저가”만 앞세움</td><td>가격만 앞세우면 낮은 품질이 오히려 병원 이미지를 깎을 수 있습니다. 무엇을 어떻게 하는지 물어보세요.</td></tr>
      </tbody>
    </table>
  </section>

  <!-- ⑤ 행동촉구 (중간) -->
  <section>
    <div class="cta-band">
      <div>
        <strong>더 하기 전에, 우리 병원이 어디서 새는지부터 확인하세요.</strong>
        <span>진단으로 새는 지점을 짚어드립니다. 파는 것이 아니라 진단입니다.</span>
      </div>
      <a class="btn primary" href="/checkup/">우리 병원, 어디서 막히는지 점검</a>
    </div>
  </section>

  <!-- ⑥ 실패 회피 : 이대로 두면 (과장 없이) -->
  <section aria-labelledby="stakes">
    <h2 id="stakes" class="section-title">지금 이대로 두면</h2>
    <div class="answer">
      <span class="k">방치의 비용</span>
      마케팅 구멍을 모른 채 지나가는 동안, 비용은 매달 그대로 새어나가고 경쟁 병원은 그만큼
      앞서갑니다. 내년 이맘때도 똑같은 고민을 반복하지 않으려면, 새는 지점부터 막아야 합니다.
    </div>
  </section>

  <!-- ⑦ 성공 : 달라지는 것 (Before → After) -->
  <section aria-labelledby="success">
    <h2 id="success" class="section-title">무엇이 달라지나</h2>
    <table class="compare">
      <thead><tr><th>현재의 고민</th><th>함께 개선할 목표</th></tr></thead>
      <tbody>
        <tr><td>마케팅 보고서를 봐도 답답했다</td><td>무엇이 되고 무엇이 새는지 스스로 설명할 수 있게 된다</td></tr>
        <tr><td>감에 의존하는 결정이 불안했다</td><td>무엇을 먼저 하고 무엇을 미룰지 판단 근거가 생긴다</td></tr>
        <tr><td>블로그가 그저 숙제처럼 느껴졌다</td><td>환자가 먼저 알아봐 주는 소중한 자산이 된다</td></tr>
      </tbody>
    </table>
    <p style="color:var(--muted);font-size:.9rem;margin-top:10px">
      ※ 위 내용은 개선 목표입니다. 검색 순위·AI 인용·문의 증가와 그 시점을 보장하지 않습니다.
    </p>
  </section>

  <!-- 인사이트 : 신뢰 축적 (칼럼 읽고 → 문의) -->
  <section aria-labelledby="latest">
    <h2 id="latest" class="section-title">인사이트 — 의심 하나씩 짚어드립니다</h2>
    <p style="color:var(--muted);margin-top:-6px">
      정보를 나열하려고 쓴 글이 아닙니다. 마케팅을 판단할 때 드는 의심(“정말 효과가 있나”,
      “또 영업 아닌가”, “우리 병원은 어디가 문제지”) 하나씩을 없애기 위해 씁니다. 읽고 스스로
      판단이 서면, 그때 점검을 신청하세요.
    </p>
    {posts.length === 0 ? (
      <p style="color:var(--muted)">첫 글을 준비 중입니다.</p>
    ) : (
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a class="title" href={`/posts/${p.id}/`}>{p.data.title}</a>
            <div class="meta">{fmt(p.data.pubDate)}</div>
            <p class="excerpt">{p.data.answer}</p>
          </li>
        ))}
      </ul>
    )}
    <p style="margin-top:18px"><a href="/posts/">→ 전체 인사이트 보기</a></p>
  </section>

  <!-- FAQ -->
  <section class="faq" aria-labelledby="faq">
    <h2 id="faq" class="section-title">자주 묻는 질문</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <!-- 최종 행동촉구 -->
  <section id="contact" aria-labelledby="contact-h">
    <h2 id="contact-h" class="section-title">가장 가벼운 첫 단계 — 유입·전환 점검</h2>
    <p style="color:var(--muted)">
      큰 계약이 아니라 진단 한 번입니다. 더베이직플랜에서 가장 낮은 위험의 첫 단계이고,
      여기서 시작하실 수 있습니다. 사전 설문에 답해주시면 유입이 어디서 새는지 진단해 글로
      회신드립니다. 상담 전화로 영업하지 않고, 이어갈지는 원장님이 정하시면 됩니다.
      <a href="/checkup/">점검이 무엇을 보는지 먼저 보기</a>.
    </p>
    {SITE.naverFormUrl ? (
      <div class="form-card">
        <p style="margin-top:0">네이버 폼(사전 설문지)으로 간편하게 신청하실 수 있습니다.</p>
        <a class="btn primary" href={SITE.naverFormUrl} target="_blank" rel="noopener noreferrer">유입 점검 신청하기 →</a>
        <p class="form-note">버튼을 누르면 네이버 사전 설문지가 새 창으로 열립니다.</p>
      </div>
    ) : (
      <div class="form-card">
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="field"><label for="name">성함 / 병원명</label><input id="name" name="name" type="text" required autocomplete="name" /></div>
          <div class="field"><label for="reply">회신받을 연락처</label><input id="reply" name="reply_to" type="text" required /></div>
          <div class="field"><label for="msg">가장 큰 고민 한 가지</label><textarea id="msg" name="message" required></textarea></div>
          <button class="btn primary" type="submit">진단 요청 보내기</button>
          <p class="form-note">제출 내용은 {SITE.email} 으로 전송됩니다.</p>
        </form>
      </div>
    )}
  </section>
</BaseLayout>
