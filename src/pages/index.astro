---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, isPublished } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft && isPublished(data.pubDate)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const faq = [
  {
    q: '이전 대행사도 다 "잘한다"고 했는데, 여긴 뭐가 다른가요?',
    a: '더베이직플랜은 원장 출신 대표가 직접 총괄하고, 대행 전 원장님과 1시간 인터뷰로 진료 철학부터 듣습니다. 병원명을 지우면 어디에도 붙는 복붙 글이 아니라, 그 병원만의 강점을 설득하는 콘텐츠를 만드는 것이 차이입니다.',
  },
  {
    q: '상위노출이나 신환 수를 "보장"해 주나요?',
    a: '보장하지 않습니다. "즉시 효과·상위노출 보장"은 저희가 가장 먼저 피하라고 말하는 위험 신호입니다. 병원 마케팅은 신뢰를 쌓는 브랜딩이라 시간이 필요합니다. 저희는 보장 대신 과정과 측정(노출·클릭·문의)을 약속합니다.',
  },
  {
    q: '원장이 바빠서 신경 못 쓰는데, 다 알아서 해주시나요?',
    a: '"다 알아서 하겠다"는 저희가 경계하는 첫 번째 신호입니다. 대신 처음 1시간 인터뷰로 방향만 함께 잡고, 이후 실행은 저희가 맡습니다. 소통은 최소한으로, 부담은 적게 — 그래도 원장님의 철학이 콘텐츠에 담기게 합니다.',
  },
  {
    q: '성과가 있는지 어떻게 확인하나요?',
    a: '"조회수 XXX회" 자랑이 아니라, 노출·클릭·문의(전환)를 기준선부터 추적해 보고합니다. "조회수는 많은데 왜 예약 전화가 안 오나"에 답할 수 있어야 진짜 마케팅입니다.',
  },
  {
    q: '월 비용은 얼마인가요? 최저가 대행사와 뭐가 다른가요?',
    a: '"업계 최저가"만 앞세우는 곳은 저희도 경계합니다. 품질 낮은 콘텐츠는 병원 이미지를 오히려 깎아먹기 때문입니다. 비용은 병원 상황을 진단한 뒤 안내드리며, 무료 진단부터 부담 없이 시작하실 수 있습니다.',
  },
  {
    q: '담당자가 자주 바뀌지 않나요?',
    a: '원장 출신 대표가 직접 총괄합니다. 좋은 대행사는 원장님을 "고객"이 아니라 "파트너"로 봅니다 — 원장님의 성공이 곧 저희의 성공이라 생각합니다.',
  },
  {
    q: '아직 확신이 안 서는데, 바로 계약해야 하나요?',
    a: '아니요. 저희 인사이트 칼럼을 몇 개 먼저 읽어보시고, 방향이 맞는다 싶을 때 무료 진단을 신청하셔도 됩니다. 핏이 맞는 파트너를 찾는 것이 서로에게 좋습니다.',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={SITE.nameKo} jsonLd={[faqJsonLd]}>
  <!-- ① 주인공 + 후킹 : 손님(원장)의 아픔에서 시작 -->
  <section class="hero">
    <span class="eyebrow">병원·의원 전문 · 원장 출신 마케터가 직접</span>
    <p class="hook">매달 마케팅비는 꼬박꼬박 나가는데,<br />신환은 왜 늘지 않을까요?</p>
    <h1>실력 있는 원장님에게<br />더 많은 보상을 만들어드립니다</h1>
    <p class="lead">
      매달 마케팅비 300만원을 쓰는데 신환은 3명.<br />
      문제는 광고비가 아니라 <strong>‘구멍 난 마케팅’</strong>입니다.<br />
      더베이직플랜은 원장님의 진료 철학에서 출발해,<br />
      검색과 AI가 병원을 <strong>먼저 알아보게</strong> 만드는 콘텐츠를 설계합니다.
    </p>
    <div class="cta-row">
      <a class="btn primary" href="#contact">무료 마케팅 진단 신청</a>
      <a class="btn ghost" href="/posts/">인사이트 먼저 보기</a>
    </div>
  </section>

  <!-- ② 문제 : 외적 + 내적(속마음) -->
  <section aria-labelledby="problem">
    <h2 id="problem" class="section-title">이런 상황, 낯익지 않으신가요?</h2>
    <div class="problem">
      <ul>
        <li>블로그 포스팅 30개를 올렸는데 예약 전화는 2통</li>
        <li>광고비 월 200만원을 쓰는데 신환 전환은 3명 미만</li>
        <li>대행사는 잘한다는데, 우리 병원 매출은 그대로</li>
        <li>조회수는 자랑하는데 “왜 예약이 안 오냐”엔 답을 못 함</li>
      </ul>
    </div>
    <div class="voices">
      <p>“이번 대행사는 다를 거야… 했는데 또 실망”</p>
      <p>“월 비용만 나가고 변한 건 없네”</p>
      <p>“담당자가 또 바뀌었다고?”</p>
    </div>
    <p class="verdict-line">
      가장 아픈 건 돈이 아닙니다. <strong>기대했다가 또 실망하는, 그 마음의 상처</strong>입니다.
    </p>
  </section>

  <!-- ③ 가이드 : 공감 먼저 → 권위는 증거로 (손님이 주인공, 우리는 조연) -->
  <section aria-labelledby="guide">
    <h2 id="guide" class="section-title">저도, 그 자리에 있었습니다</h2>
    <div class="founder" style="margin-bottom:18px">
      <div class="avatar" aria-hidden="true">강</div>
      <div>
        <p style="margin:0"><strong>{SITE.founder}</strong> · {SITE.nameKo} 대표 · 원장 출신 마케터</p>
        <p class="who">수백 곳의 병·의원을 분석하며 ‘성공하는 마케팅의 공통 공식’을 찾았습니다.</p>
      </div>
    </div>
    <p style="color:var(--muted);max-width:640px">
      대행사 선택의 실패가 단순히 돈의 문제가 아니라는 걸 압니다. 원장 출신이기에, 매일 최선을
      다해도 인정받기 어려운 그 외로움도 압니다. 그래서 저는 <strong>행운을 바라며 일하지
      않습니다</strong> — 운이 아니라 철저한 계획으로 원장님의 실력을 드러냅니다.
    </p>
  </section>

  <!-- ④ 계획 : 위험을 없애는 명확한 여정 -->
  <section aria-labelledby="how">
    <h2 id="how" class="section-title">그래서, 이렇게 진행됩니다</h2>
    <div class="steps">
      <div class="step"><div>
        <h3>대행 전, 원장님과 1시간 인터뷰</h3>
        <p>병원 철학·환자층·운영 방식까지. 모든 전략은 원장님의 ‘진료 철학’을 듣는 데서 시작합니다.</p>
      </div></div>
      <div class="step"><div>
        <h3>원장님 관점의 키워드 분석</h3>
        <p>단순 검색량이 아니라 “우리 병원에 맞는 환자가 찾는 키워드”. 검색량 높은 키워드가 때론 독이 됩니다.</p>
      </div></div>
      <div class="step"><div>
        <h3>마케팅 누수 지점 진단</h3>
        <p>블로그·플레이스·유튜브 중 어디서 전환이 새는지 정확히 짚습니다. “아, 여기서 새고 있었구나!”</p>
      </div></div>
      <div class="step"><div>
        <h3>향후 3개월 맞춤 전략</h3>
        <p>병원에 맞는 우선순위와 예상 효과까지. 감이 아니라 데이터 기반의 방향을 드립니다.</p>
      </div></div>
    </div>
  </section>

  <!-- 신뢰 보강 : 피해야 할 신호 (가이드가 믿을 만한 이유) -->
  <section aria-labelledby="diff">
    <h2 id="diff" class="section-title">이런 대행사는 피하세요 — 우리는 이렇게 다릅니다</h2>
    <table class="compare">
      <thead><tr><th>피해야 할 위험 신호</th><th>더베이직플랜</th></tr></thead>
      <tbody>
        <tr><td>“원장님은 진료만 하세요, 다 알아서 할게요”</td><td>원장님의 진료 철학부터 듣고 함께 만듭니다 (파트너)</td></tr>
        <tr><td>“즉시 효과·상위노출 보장합니다”</td><td>브랜딩은 시간이 필요합니다. 운이 아닌 계획으로</td></tr>
        <tr><td>“업계 최저가”만 앞세움</td><td>잘못된 마케팅은 안 하느니만 못합니다. 품질을 지킵니다</td></tr>
      </tbody>
    </table>
  </section>

  <!-- ⑤ 행동촉구 (중간) -->
  <section>
    <div class="cta-band">
      <div>
        <strong>먼저, 우리 병원의 ‘구멍’이 어디인지부터 확인하세요.</strong>
        <span>무료 진단으로 새는 지점을 짚어드립니다.</span>
      </div>
      <a class="btn primary" href="#contact">무료 마케팅 진단 신청</a>
    </div>
  </section>

  <!-- ⑥ 실패 회피 : 이대로 두면 (과장 없이) -->
  <section aria-labelledby="stakes">
    <h2 id="stakes" class="section-title">지금 이대로 두면</h2>
    <div class="answer">
      <span class="k">방치의 비용</span>
      마케팅 구멍을 모른 채 지나가는 동안, 비용은 매달 그대로 새어나가고 경쟁 병원은 그만큼
      앞서갑니다. 내년 이맘때도 똑같은 고민을 반복하지 않으려면, 새는 지점부터 막아야 합니다.
    </div>
  </section>

  <!-- ⑦ 성공 : 달라지는 것 (Before → After) -->
  <section aria-labelledby="success">
    <h2 id="success" class="section-title">무엇이 달라지나</h2>
    <table class="compare">
      <thead><tr><th>지금 (Before)</th><th>함께한 뒤 (After)</th></tr></thead>
      <tbody>
        <tr><td>마케팅 보고서를 봐도 답답했다</td><td>데이터 기반의 명확한 방향을 갖는다</td></tr>
        <tr><td>감에 의존하는 결정이 불안했다</td><td>우리 병원만의 이기는 전략에 확신이 생긴다</td></tr>
        <tr><td>블로그가 그저 숙제처럼 느껴졌다</td><td>환자가 먼저 알아봐 주는 소중한 자산이 된다</td></tr>
      </tbody>
    </table>
    <p style="color:var(--muted);font-size:.9rem;margin-top:10px">
      ※ 실제 대행 중인 원장님들의 후기는 준비되는 대로 이곳에 담습니다.
    </p>
  </section>

  <!-- 인사이트 : 신뢰 축적 (칼럼 읽고 → 문의) -->
  <section aria-labelledby="latest">
    <h2 id="latest" class="section-title">최신 인사이트</h2>
    <p style="color:var(--muted);margin-top:-6px">
      바로 계약하라고 하지 않습니다. 몇 개 읽어보시고 방향이 맞으면 그때 문의하세요.
    </p>
    {posts.length === 0 ? (
      <p style="color:var(--muted)">첫 글을 준비 중입니다.</p>
    ) : (
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a class="title" href={`/posts/${p.id}/`}>{p.data.title}</a>
            <div class="meta">{fmt(p.data.pubDate)}</div>
            <p class="excerpt">{p.data.answer}</p>
          </li>
        ))}
      </ul>
    )}
    <p style="margin-top:18px"><a href="/posts/">→ 전체 인사이트 보기</a></p>
  </section>

  <!-- FAQ -->
  <section class="faq" aria-labelledby="faq">
    <h2 id="faq" class="section-title">자주 묻는 질문</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <!-- 최종 행동촉구 -->
  <section id="contact" aria-labelledby="contact-h">
    <h2 id="contact-h" class="section-title">무료 마케팅 진단 신청</h2>
    <p style="color:var(--muted)">
      사전 설문에 답해주시면, 원장님 병원의 ‘마케팅 누수 지점’을 진단해 회신드립니다.
    </p>
    {SITE.naverFormUrl ? (
      <div class="form-card">
        <p style="margin-top:0">네이버 폼(사전 설문지)으로 간편하게 신청하실 수 있습니다.</p>
        <a class="btn primary" href={SITE.naverFormUrl} target="_blank" rel="noopener noreferrer">무료 진단 신청하기 →</a>
        <p class="form-note">버튼을 누르면 네이버 사전 설문지가 새 창으로 열립니다.</p>
      </div>
    ) : (
      <div class="form-card">
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="field"><label for="name">성함 / 병원명</label><input id="name" name="name" type="text" required autocomplete="name" /></div>
          <div class="field"><label for="reply">회신받을 연락처</label><input id="reply" name="reply_to" type="text" required /></div>
          <div class="field"><label for="msg">가장 큰 고민 한 가지</label><textarea id="msg" name="message" required></textarea></div>
          <button class="btn primary" type="submit">진단 요청 보내기</button>
          <p class="form-note">제출 내용은 {SITE.email} 으로 전송됩니다.</p>
        </form>
      </div>
    )}
  </section>
</BaseLayout>
