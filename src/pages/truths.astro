---
import BaseLayout from '../layouts/BaseLayout.astro';

const url = new URL('/truths/', Astro.site).href;
const orgId = new URL('/#org', Astro.site).href;

const truths = [
  {
    n: 1,
    title: '유입을 늘리는 것이 늘 답은 아니다',
    thesis: '이미 오는 환자가 새고 있다면, 더 붓는 것은 답이 아닙니다. 늘리기 전에 어디서 막혔는지부터 봅니다.',
    href: '/posts/marketing-truth-1-more-isnt-the-answer/',
  },
  {
    n: 2,
    title: "좋은 마케팅은 ‘더 하라’고만 하지 않는다",
    thesis: '무엇을 멈춰도 되는지 아는 것이 먼저입니다. “이건 지금 안 하셔도 됩니다”가 더 정직한 신호입니다.',
    href: '/posts/marketing-truth-2-not-always-more/',
  },
  {
    n: 3,
    title: '성공사례는 미래를 보장하지 않는다',
    thesis: '남의 사례보다 “어떻게 측정했나”와 “우리 병원 숫자로 확인되나”가 더 믿을 신호입니다.',
    href: '/posts/marketing-truth-3-case-studies/',
  },
  {
    n: 4,
    title: '노출은 후보에 드는 일, 선택은 이유가 만든다',
    thesis: '노출을 늘리기 전에, 환자가 우리를 고를 이유부터 세워야 합니다.',
    href: null,
  },
  {
    n: 5,
    title: 'AI 검색은 새 상품이 아니라 새 환경이다',
    thesis: 'AEO·GEO는 사야 할 상품이 아니라 바뀐 조건입니다. 기본이 빈 채로 새 채널부터 살 일이 아닙니다.',
    href: null,
  },
  {
    n: 6,
    title: '원장에게 필요한 건 대행사가 아니라 판단해줄 시선이다',
    thesis: '마케팅 잘하는 사람보다, 지금 무엇이 되고 무엇이 새는지 대신 판단해줄 사람이 귀합니다.',
    href: null,
  },
];

const faq = [
  { q: '‘6가지 진실’은 무엇인가요?', a: '병원 마케팅을 판단할 때 먼저 깨야 할 여섯 가지 통념입니다. 각 편이 원장님이 흔히 갖는 의심 하나를 다룹니다.' },
  { q: '순서대로 읽어야 하나요?', a: '1편부터 권하지만, 관심 가는 진실부터 읽으셔도 됩니다. 각 편은 따로도 읽히도록 썼습니다.' },
  { q: '이 글들은 무엇을 팔기 위한 건가요?', a: '무엇을 사라고 설득하기 위한 글이 아니라, 판단 기준을 드리기 위한 글입니다. 읽고 스스로 판단이 서면 그때 점검을 신청하시면 됩니다.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${url}#truths`,
  name: '병원 마케팅의 6가지 진실',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: truths.length,
  itemListElement: truths.map((t) => ({
    '@type': 'ListItem',
    position: t.n,
    name: t.title,
    ...(t.href ? { url: new URL(t.href, Astro.site).href } : {}),
  })),
};
---

<BaseLayout
  title="병원 마케팅의 6가지 진실"
  description="병원 마케팅을 판단하기 전에 먼저 깨야 할 여섯 가지 통념입니다. 유입을 늘리는 것이 늘 답은 아니라는 것부터, 원장에게 필요한 건 대행사가 아니라 판단해줄 시선이라는 것까지."
  path="/truths/"
  jsonLd={[itemListJsonLd, faqJsonLd]}
>
  <section class="hero" style="padding-bottom:12px">
    <span class="eyebrow">고정 시리즈</span>
    <h1>병원 마케팅의 6가지 진실</h1>
    <p class="lead">
      마케팅을 더 하기 전에, 판단부터 바꿔야 할 때가 있습니다. 이 여섯 편은 원장님이 흔히
      갖는 통념 하나씩을 짚습니다. 무엇을 사라는 글이 아니라, 스스로 판단하실 기준을 드리는
      글입니다.
    </p>
  </section>

  <section aria-labelledby="list">
    <h2 id="list" class="section-title">여섯 가지 진실</h2>
    <ol class="truths">
      {truths.map((t) => (
        <li class="truth">
          <span class="tn">{t.n}</span>
          <div class="tbody">
            {t.href ? (
              <a class="ttitle" href={t.href}>{t.title}</a>
            ) : (
              <span class="ttitle muted-title">{t.title} <span class="soon">준비 중</span></span>
            )}
            <p class="tthesis">{t.thesis}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="why">
    <h2 id="why" class="section-title">왜 이 여섯 개인가</h2>
    <div class="answer">
      <span class="k">관점을 바꾸는 순서</span>
      이 여섯은 “마케팅이 왜 안 되지?”라는 질문을 “우리 병원 유입의 어디가 막혀 있지?”로
      바꾸는 순서입니다. 질문이 바뀌면, 돈을 더 쓰기 전에 확인부터 하게 됩니다.
    </div>
    <p style="margin-top:18px">
      우리 병원은 지금 어디가 막혀 있는지 확인하고 싶으시면 <a href="/checkup/">유입·전환 점검</a>에서
      짚어드립니다. 보장이 아니라 진단입니다.
    </p>
  </section>

  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="section-title">자주 묻는 질문</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>
</BaseLayout>

<style>
  .truths { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .truth { display:grid; grid-template-columns:52px 1fr; align-items:start;
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; }
  .tn { display:flex; align-items:center; justify-content:center; align-self:stretch;
    background:var(--accent); color:var(--accent-ink); font-weight:700; font-size:1.2rem; }
  .tbody { padding:14px 18px 16px; }
  .ttitle { display:inline-block; font-weight:700; font-size:1.08rem; color:var(--text); text-decoration:none; }
  a.ttitle { border-bottom:1.5px solid var(--accent); padding-bottom:1px; }
  a.ttitle:hover { color:var(--accent); }
  .muted-title { color:var(--muted); font-weight:700; }
  .soon { font-size:.72rem; font-weight:600; color:var(--muted); border:1px solid var(--border);
    border-radius:999px; padding:1px 8px; margin-left:6px; vertical-align:middle; }
  .tthesis { margin:6px 0 0; color:var(--muted); font-size:.94rem; line-height:1.55; }
</style>
